<?xml version="1.0" encoding="utf-8"?>
<!-- The month widget (MonthWidget.kt). Each drawn part comes twice; the
     integers light_visibility and dark_visibility show the one of the
     launcher's night mode. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <!-- The card's 1 dp border and its padding of 10 dp by 12 dp. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingVertical="11dp">

        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/header_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:visibility="@integer/light_visibility" />

            <ImageView
                android:id="@+id/header_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:visibility="@integer/dark_visibility" />
        </FrameLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- "+": its drawing, with room for the shadow, and its 40 dp tap area. -->
    <ImageView
        android:id="@+id/fab_light"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:importantForAccessibility="no"
        android:visibility="@integer/light_visibility" />

    <ImageView
        android:id="@+id/fab_dark"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:importantForAccessibility="no"
        android:visibility="@integer/dark_visibility" />

    <FrameLayout
        android:id="@+id/fab"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="13dp"
        android:contentDescription="@string/new_entry" />
</FrameLayout>
