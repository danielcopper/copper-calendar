<?xml version="1.0" encoding="utf-8"?>
<!-- One day of the week widget "Woche": the drawn row, light and dark, over
     it the day's transparent tap area, and above that a tap area per entry,
     which WeekWidget adds (widget_week_entry.xml) where the row draws the
     entries. The tap areas are children of the row, not its root: a list
     row's root gets no click handling of its own from its fill-in intent.
     The row is drawn at the width the launcher reports and shown unscaled,
     at the top left: scaled to a wider list, it would grow taller and its
     entries would slide away from their tap areas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/day_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="matrix"
        android:visibility="@integer/light_visibility" />

    <ImageView
        android:id="@+id/day_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="matrix"
        android:visibility="@integer/dark_visibility" />

    <FrameLayout
        android:id="@+id/day_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</FrameLayout>
