<?xml version="1.0" encoding="utf-8"?>
<!-- The drawn header, light and dark, scaled to the header's width, as the
     month and "Woche quer" include it; "Woche" shows its header unscaled
     (widget_header_images_unscaled.xml). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/header_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:visibility="@integer/light_visibility" />

    <ImageView
        android:id="@+id/header_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:visibility="@integer/dark_visibility" />
</merge>
