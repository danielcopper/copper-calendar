<?xml version="1.0" encoding="utf-8"?>
<!-- The drawn header, light and dark, as each widget's header includes it. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/header_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:visibility="@integer/light_visibility" />

    <ImageView
        android:id="@+id/header_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:visibility="@integer/dark_visibility" />
</merge>
