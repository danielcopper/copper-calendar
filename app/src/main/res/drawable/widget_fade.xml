<?xml version="1.0" encoding="utf-8"?>
<!-- The fade at the bottom of "Woche quer": from the card's colour, clear, to
     the card's colour at its bottom edge, light or dark by night-mode
     resources, so it needs no drawn bitmap. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_card"
        android:startColor="@color/widget_card_clear" />
</shape>
